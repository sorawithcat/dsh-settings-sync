{
  "name": "dsh-settings-sync",
  "version": "0.2.0",
  "description": "设置同步插件：一份 JSON 带走插件清单、profile 配置、$DSH_HOME 文件与浏览器本地设置，导入后可在 profile 目录一键重装插件；与插件市场的 dsh-profile-backup 0.2 格式互通。",
  "icon": "icon.svg",
  "type": "module",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorawithcat/dsh-settings-sync.git"
  },
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2 <0.3.0-0 || >=0.3.0-rc.1 <0.4.0-0 || >=0.4.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0 || >=0.3.0-rc.1 <0.4.0-0 || >=0.4.0-rc.1"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "license": "BSD-3-Clause"
}
